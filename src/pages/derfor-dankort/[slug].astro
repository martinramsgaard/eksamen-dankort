---
import BenefitCard from "../../components/BenefitCard.astro";
import { getBenefitIllustration } from "../../lib/benefitVisuals";
import { getBenefitStories } from "../../lib/benefits";
import MainLayout from "../../layouts/MainLayout.astro";
import type { BenefitStory } from "../../types/benefit";

// getStaticPaths fortæller Astro, hvilke dynamiske URL'er der skal bygges.
// Der oprettes én statisk side for hver publiceret historie fra Supabase.
export async function getStaticPaths() {
  const stories = await getBenefitStories();

  return stories.map((benefit) => ({
    // Slug bliver den dynamiske del af URL'en.
    params: { slug: benefit.slug },

    // Den aktuelle historie og hele listen sendes videre som props.
    props: { benefit, allStories: stories },
  }));
}

// Props beskriver de data, som getStaticPaths sender til siden.
interface Props {
  benefit: BenefitStory;
  allStories: BenefitStory[];
}

const { benefit, allStories } = Astro.props;

// Brødteksten er gemt som én tekst i Supabase.
// Tomme linjer bruges til at opdele teksten i afsnit.
const paragraphs = benefit.body.split(/\n\s*\n/).filter(Boolean);

// De to andre historier vises nederst på siden.
const related = allStories
  .filter((story) => story.slug !== benefit.slug)
  .slice(0, 2);

// Illustration og baggrundsfarve bestemmes af historiens kategori.
const illustration = getBenefitIllustration(benefit.category);
const heroClass = `story-hero story-hero--${benefit.category}`;
---

<MainLayout title={benefit.title} description={benefit.summary}>
  <article>
    <!-- Historien starter med titel, resumé og tilhørende illustration. -->
    <header class={heroClass}>
      <div class="container story-hero__grid">
        <div class="story-hero__copy">
          <p class="eyebrow">{benefit.eyebrow}</p>
          <h1>{benefit.title}</h1>
          <p class="lead">{benefit.summary}</p>
        </div>

        <!-- Illustrationen er dekorativ; teksten forklarer allerede emnet. -->
        <div class="story-hero__visual">
          <img src={illustration} alt="" width="640" height="420" />
        </div>
      </div>
    </header>

    <!-- Brødtekst og de vigtigste pointer. -->
    <div class="story-body section--large">
      <div class="container story-body__grid">
        <div class="story-body__copy">
          <!-- Hvert afsnit fra Supabase vises som sit eget p-element. -->
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <!-- Boksen samler historiens vigtigste pointer og næste handling. -->
        <aside class="takeaways" aria-labelledby="takeaway-title">
          <h2 id="takeaway-title">Det kan du tage med dig</h2>

          <ul>
            {benefit.takeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>

          <a class="button button--dark" href="/#tjek-dit-kort">
            Tjek dit kort
          </a>
        </aside>
      </div>
    </div>
  </article>

  <!-- De øvrige historier giver mulighed for at læse videre. -->
  <section class="related section">
    <div class="container">
      <p class="eyebrow">Læs også</p>
      <h2 class="section-title">Flere sider af Dankort</h2>

      <div class="related__grid">
        {related.map((story) => <BenefitCard benefit={story} />)}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Fælles afstand for alle tre historie-heroer. */
  .story-hero {
    padding-block: var(--space-xl);
  }

  /* Naturhistorien får en lys grøn baggrund. */
  .story-hero--natur {
    background: #e8f9ed;
  }

  /* Butikshistorien får en lys rød baggrund. */
  .story-hero--butikker {
    background: #fde9ea;
  }

  /* Beredskabshistorien får en lys gul baggrund. */
  .story-hero--beredskab {
    background: #fff5c7;
  }

  /* Mobile-first: tekst og illustration står under hinanden. */
  .story-hero__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  /* Historiens hovedoverskrift skalerer responsivt. */
  .story-hero h1 {
    max-width: 15ch;
    font-size: clamp(2.8rem, 11vw, 6.5rem);
    font-weight: 850;
    letter-spacing: -0.07em;
    line-height: 0.94;
  }

  /* Resuméet får afstand fra overskriften. */
  .story-hero .lead {
    margin-top: var(--space-md);
  }

  /* Visualfeltet følger illustrationens faste billedformat. */
  .story-hero__visual {
    aspect-ratio: 640 / 420;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* Illustrationen udfylder hele visualfeltet uden mellemrum. */
  .story-hero__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile-first: artikeltekst og takeaway-boks står under hinanden. */
  .story-body__grid {
    display: grid;
    gap: var(--space-lg);
  }

  /* Brødteksten får ens afstand mellem afsnit og en læsbar maksimal bredde. */
  .story-body__copy {
    display: grid;
    gap: 1.35rem;
    max-width: 68ch;
    font-size: 1.06rem;
  }

  /* Takeaway-boksen fremhæver historiens vigtigste pointer. */
  .takeaways {
    align-self: start;
    padding: 1.35rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: var(--color-cream);
  }

  /* Takeaway-boksens overskrift. */
  .takeaways h2 {
    margin-bottom: var(--space-sm);
    font-size: 1.45rem;
  }

  /* Punktlisten har tydelig afstand mellem pointerne. */
  .takeaways ul {
    display: grid;
    gap: 0.8rem;
    padding-left: 1.25rem;
    margin-bottom: var(--space-md);
  }

  /* Relaterede historier adskilles med lysegrå baggrund. */
  .related {
    background: var(--color-gray);
  }

  /* Mobile-first: de to relaterede kort står under hinanden. */
  .related__grid {
    display: grid;
    gap: 1rem;
    margin-top: var(--space-lg);
  }

  /* Desktoplayoutet aktiveres ved 800 px. */
  @media (min-width: 800px) {
    /* Heroen får mere lodret luft. */
    .story-hero {
      padding-block: 6.5rem;
    }

    /* Tekst og illustration står ved siden af hinanden. */
    .story-hero__grid {
      grid-template-columns: 1fr 0.8fr;
    }

    /* Brødtekst og takeaway-boks fordeles i to kolonner. */
    .story-body__grid {
      grid-template-columns: 1fr 0.55fr;
      align-items: start;
    }

    /* Takeaway-boksen får mere indvendig luft. */
    .takeaways {
      padding: 1.8rem;
    }

    /* De to relaterede historier vises side om side. */
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
